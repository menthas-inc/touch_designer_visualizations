.DS_Store
__pycache__/
*.log

# TouchDesigner writes these next to the .toe on every save and crash.
Backup/
CrashAutoSave.*
*.dmp

# The project folder as unzipped. Only the .toe files are tracked; 1.8 GB of source videos
# stay on disk and out of git (open call in docs/tech/decisions.md).
TD_Mapping/*
!TD_Mapping/*.toe
# TouchDesigner's incremented saves (Studio_Up_new.1.toe). Save by name from the Textport.
TD_Mapping/*.[0-9]*.toe
