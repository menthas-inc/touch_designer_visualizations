.DS_Store
__pycache__/
*.log

# TouchDesigner writes these next to the .toe on every save and crash.
Backup/
CrashAutoSave.*
*.dmp

# The project folder. Only the .toe files are tracked; the clips stay on disk and out of git
# (docs/tech/decisions.md, 2026-11-12).
TD_Mapping/*
!TD_Mapping/*.toe
# TouchDesigner's incremented saves (Studio_Up_new.1.toe). Save by name from the Textport.
TD_Mapping/*.[0-9]*.toe

# the beat tracker sidecar: its environment and models
beat/.venv/
beat/*.log
